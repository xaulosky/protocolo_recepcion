# Conexión a Postgres
DATABASE_URL="postgresql://cialo:cialo@localhost:5433/cialo_hub?schema=public"

# Servidor
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"

# JWT (cambiar en producción por valores aleatorios largos)
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30

# Email (SMTP) — opcional en dev
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Cialo Hub <no-reply@cialo.cl>"

# Web Push (VAPID) — generar con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contacto@cialo.cl"

# Usuario admin inicial (seed)
SEED_ADMIN_EMAIL="admin@cialo.cl"
SEED_ADMIN_PASSWORD="admin1234"

# ── Boletas electrónicas (SII) ──
# Apagado hasta tener certificado digital y CAF cargados.
BOLETAS_HABILITADAS=false
PRECIOS_INCLUYEN_IVA=true
SII_AMBIENTE=certificacion
# Datos del emisor — obtener desde "Mi SII" (no abreviar el giro).
SII_RUT_EMISOR="78155814-1"
SII_RAZON_SOCIAL="CENTRO MEDICO CIALO SPA"
SII_GIRO="Actividades de centros medicos privados"
SII_ACTECO="862020"
# Largos maximos que exige el esquema del SII: giro 80, direccion 70,
# comuna y ciudad 20, razon social 100. Pasarse de ahi hace rechazar el DTE.
SII_DIR_ORIGEN="Bulnes 220, oficina 509"
SII_CMNA_ORIGEN="Los Angeles"
SII_CIUDAD_ORIGEN="Los Angeles"
SII_NOMBRE_SOFTWARE="ADMINISTRACION.CIALO.CL"
# Durante la certificación: agrega la referencia al caso del set en cada DTE.
SII_SET_PRUEBAS=false

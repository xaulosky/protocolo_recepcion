// Cialo Hub — esquema de base de datos
// Convención: la data de la clínica conserva sus ids originales (slugs/números)
// para preservar las relaciones que ya existían en los archivos estáticos.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Auth & usuarios ─────────────────────────────

enum Role {
  ADMIN
  RECEPCION
  PROFESIONAL
  LECTURA
  // Estación de un box (ej. "Box 3"): solo ve mensajería. Su línea con Recepción
  // es un buzón privado (Conversation.buzonBoxId).
  BOX
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  nombre       String
  role         Role     @default(RECEPCION)
  activo       Boolean  @default(true)
  // Secciones (ViewIds) que el usuario puede ver. Vacío = usar defaults del rol.
  permisos     String[] @default([])
  // Cuenta compartida/estación (ej. "Recepción"): se oculta del selector de
  // mensajes directos; se le escribe por el canal, no como DM individual.
  ocultarEnDM  Boolean  @default(false)
  // Acceso al Copiloto IA (chat con DeepSeek); activable por el admin, por usuario.
  copilotoHabilitado Boolean @default(false)
  // Si el usuario es un profesional, enlaza a su ficha clínica.
  professional   Professional? @relation(fields: [professionalId], references: [id])
  professionalId String?
  // Perfil personal (editable por el propio usuario).
  telefono        String?
  fechaNacimiento String? // "YYYY-MM-DD" — usado para el aviso de cumpleaños

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  tareasAsignadas   Task[]             @relation("TareaAsignadas")
  tareasCreadas     Task[]             @relation("TareaCreador")
  taskActivities    TaskActivity[]
  cirugiasCreadas   Cirugia[]          @relation("CirugiaCreador")
  comunicacionLogs  ComunicacionLog[]
  cirugiaActividad  CirugiaActividad[] @relation("CirugiaActividadUsuario")
  cirugiaAbonos     CirugiaAbono[]     @relation("AbonoRegistradoPor")
  signedConsents    SignedConsent[]    @relation("ConsentCreador")
  reglasConsentimiento ReglaConsentimiento[] @relation("ReglaConsentimientoCreador")
  consentsFirmaManual  SignedConsent[]    @relation("ConsentFirmaManualPor")
  consentsAnulados     SignedConsent[]    @relation("ConsentAnuladoPor")
  cafsCargados         Caf[]              @relation("CafCargadoPor")
  chatMemberships   ConversationMember[]
  mensajes          Message[]
  reacciones        MessageReaction[]
  quotes            Quote[]            @relation("QuoteCreador")
  giftCards         GiftCard[]         @relation("GiftCardCreador")
  reembolsos           SolicitudReembolso[]    @relation("ReembolsoCreador")
  reembolsoActividad   ReembolsoActividad[]    @relation("ReembolsoActividadUsuario")
  pagosProfCreados     PagoProfesional[]       @relation("PagoProfCreador")
  inventarioItems       InventarioItem[]       @relation("InventarioCreadoPor")
  inventarioMovimientos InventarioMovimiento[] @relation("InventarioMovUsuario")
  documentos            UserDocument[]         @relation("DocumentosUsuario")
  documentosSubidos     UserDocument[]         @relation("DocumentosSubidoPor")
  copilotoMensajes      CopilotoMensaje[]
  turnosAbiertos        Turno[]                @relation("TurnoAbiertoPor")
  turnosCerrados        Turno[]                @relation("TurnoCerradoPor")
  ventasVendedor        Venta[]                @relation("VentaVendedor")
  ventasAnuladas        Venta[]                @relation("VentaAnuladaPor")
  eventosCreados        EventoInterno[]
  // Si el usuario es una estación Box, su buzón privado con Recepción.
  buzon             Conversation? @relation("BuzonBox")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
}

// Refresh tokens con rotación: se guarda solo el hash del token.
model RefreshToken {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Token de recuperación de contraseña: se guarda solo el hash (sha256).
model PasswordResetToken {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ───────────────────────────── Notificaciones ─────────────────────────────

// Documento personal de un usuario (contrato, anexo, liquidación, etc.).
// El archivo vive en disco (api/uploads/documentos/<userId>/); aquí solo la metadata.
model UserDocument {
  id          String   @id @default(cuid())
  user        User     @relation("DocumentosUsuario", fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  tipo        String   // CONTRATO | ANEXO | LIQUIDACION | CERTIFICADO | OTRO
  titulo      String
  filename    String   // nombre original del archivo
  path        String   // ruta relativa dentro de uploads/
  mime        String
  size        Int
  periodo     String?  // para liquidaciones: "YYYY-MM"
  notas       String?
  subidoPor   User?    @relation("DocumentosSubidoPor", fields: [subidoPorId], references: [id], onDelete: SetNull)
  subidoPorId String?
  vistoAt     DateTime? // primera descarga/vista por el dueño (acuse de recibo)
  createdAt   DateTime @default(now())

  @@index([userId])
}

// Mensaje del Copiloto IA (chat 1:1 usuario↔asistente, sin modelo de "Conversación"
// separado). role: 'user' | 'assistant' | 'tool'.
model CopilotoMensaje {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  role       String
  contenido  String   @db.Text
  toolName   String?
  toolArgs   Json?
  toolResult Json?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}

enum NotificationType {
  TAREA_ASIGNADA
  TAREA_ACTUALIZADA
  REEMBOLSO
  SISTEMA
}

model Notification {
  id        String           @id @default(cuid())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      NotificationType @default(SISTEMA)
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// ───────────────────────────── Tareas (Kanban) ─────────────────────────────

enum Etapa {
  PENDIENTE
  ASIGNADO
  EN_PROCESO
  REVISION
  CERRADO
}

enum Prioridad {
  BAJA
  NORMAL
  URGENTE
}

// ─────────────────────────────── Cirugías / Procedimientos ─────────────────────────────────

enum EtapaCirugia {
  EVALUACION
  PRESUPUESTO_ENVIADO
  CONFIRMADO
  PREPARACION
  EN_EJECUCION
  POST_OPERATORIO
  CERRADO
}

enum PresupuestoEstado {
  PENDIENTE
  APROBADO
  RECHAZADO
}

enum InsumoTipo {
  INSUMO
  INSTRUMENTAL
}

enum CanalComunicacion {
  LLAMADA
  EMAIL
  WHATSAPP
  PRESENCIAL
  OTRO
}

model Task {
  id          String    @id @default(cuid())
  tipo        String
  descripcion String
  paciente    String?
  etapa       Etapa     @default(PENDIENTE)
  prioridad   Prioridad @default(NORMAL)
  dueAt       DateTime?
  tags        String[]  @default([])

  asignadas    User[]  @relation("TareaAsignadas")
  creadoPor    User?   @relation("TareaCreador", fields: [creadoPorId], references: [id])
  creadoPorId  String?

  activities TaskActivity[]
  checklist  TaskChecklist[]

  // Vinculación opcional con un procedimiento/cirugía
  cirugiaId   String?
  cirugia     Cirugia? @relation(fields: [cirugiaId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([etapa])
  @@index([dueAt])
  @@index([cirugiaId])
}

model TaskActivity {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  tipo      String
  detalle   String?
  createdAt DateTime @default(now())

  @@index([taskId])
}

model TaskChecklist {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  contenido String
  done      Boolean  @default(false)
  orden     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([taskId])
}

// ───────────────────────────── Comercial ─────────────────────────────

enum GiftCardEstado {
  ACTIVA
  CANJEADA
  ANULADA
}

enum ReembolsoEstado {
  PENDIENTE
  EN_REVISION
  APROBADO
  RECHAZADO
}

// Estado de un pago de honorarios a un profesional.
enum PagoEstado {
  PAGADO
  PENDIENTE_PAGO
  PENDIENTE_FACTURA
  PENDIENTE_BOLETA
}

// Presupuesto generado en la sección Comercial (no vinculado a cirugía).
model Quote {
  id          String   @id @default(cuid())
  paciente    String
  rut         String?
  telefono    String?
  email       String?
  items       Json     @default("[]") // [{ nombre, cat, precio, cantidad }]
  subtotal    Int      @default(0)
  descuento   Int      @default(0) // porcentaje 0-100
  total       Int      @default(0)
  notas       String?
  creadoPor   User?    @relation("QuoteCreador", fields: [creadoPorId], references: [id], onDelete: SetNull)
  creadoPorId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([creadoPorId])
  @@index([createdAt])
}

model GiftCard {
  id          String          @id @default(cuid())
  para        String
  de          String?
  monto       Int
  codigo      String          @unique
  mensaje     String?
  estado      GiftCardEstado  @default(ACTIVA)
  canjeoAt    DateTime?
  notas       String?
  creadoPor   User?           @relation("GiftCardCreador", fields: [creadoPorId], references: [id], onDelete: SetNull)
  creadoPorId String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([estado])
  @@index([createdAt])
}

model SolicitudReembolso {
  id          String          @id @default(cuid())
  paciente    String
  rut         String?
  telefono    String?
  fechaPago   String?         // texto libre para flexibilidad (ej. "12/06/2026")
  monto       String?         // texto libre (ej. "$150.000")
  motivo      String
  email           String?
  banco           String?
  tipoCuenta      String?         // "Corriente" | "Vista / RUT" | "Ahorro" | "Empresa"
  cuenta          String?
  titular         String?         // nombre titular si difiere del paciente
  urgente         Boolean         @default(false)
  fechaSolicitud  String?         // cuándo el paciente hizo la solicitud (texto libre)
  estado          ReembolsoEstado @default(PENDIENTE)
  notas           String?         // notas internas del equipo
  creadoPor   User?               @relation("ReembolsoCreador", fields: [creadoPorId], references: [id], onDelete: SetNull)
  creadoPorId String?
  actividad   ReembolsoActividad[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([estado])
  @@index([urgente])
  @@index([createdAt])
}

model ReembolsoActividad {
  id          String             @id @default(cuid())
  reembolsoId String
  reembolso   SolicitudReembolso @relation(fields: [reembolsoId], references: [id], onDelete: Cascade)
  userId      String
  user        User               @relation("ReembolsoActividadUsuario", fields: [userId], references: [id])
  tipo        String             // CREACION | ESTADO | EDICION
  detalle     String?
  createdAt   DateTime           @default(now())

  @@index([reembolsoId])
}

// ───────────────────────────── Calendario general ─────────────────────────────

enum EventoCategoria {
  REUNION
  FERIADO
  OTRO
}

// Evento interno visible para todo el equipo en el Calendario general
// (reuniones, capacitaciones, feriados/cierres de la clínica, u otro).
model EventoInterno {
  id          String          @id @default(cuid())
  titulo      String
  descripcion String?
  categoria   EventoCategoria @default(OTRO)
  fecha       DateTime        // inicio (o único día si fechaFin es null)
  fechaFin    DateTime?       // fin, para eventos de varios días (ej. cierre de clínica)
  todoElDia   Boolean         @default(true)
  creadoPor   User            @relation(fields: [creadoPorId], references: [id])
  creadoPorId String
  createdAt   DateTime        @default(now())

  @@index([fecha])
}

// ───────────────────────────── Caja / Punto de venta ─────────────────────────────

enum TurnoEstado {
  ABIERTO
  CERRADO
}

enum MetodoPago {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
}

// Turno de caja GLOBAL (una sola caja física en la clínica): solo puede haber
// uno ABIERTO a la vez; cualquier usuario con permiso puede operarlo.
model Turno {
  id            String      @id @default(cuid())
  estado        TurnoEstado @default(ABIERTO)
  montoInicial  Int         @default(0) // efectivo inicial en el cajón (CLP)
  aperturaNotas String?
  abiertoPor    User        @relation("TurnoAbiertoPor", fields: [abiertoPorId], references: [id])
  abiertoPorId  String
  abiertoAt     DateTime    @default(now())

  // Cierre: el esperado = montoInicial + Σ ventas EFECTIVO no anuladas del turno.
  montoContado  Int?
  montoEsperado Int?
  diferencia    Int?
  cierreNotas   String?
  cerradoPor    User?     @relation("TurnoCerradoPor", fields: [cerradoPorId], references: [id], onDelete: SetNull)
  cerradoPorId  String?
  cerradoAt     DateTime?

  ventas Venta[]

  @@index([estado])
  @@index([abiertoAt])
}

model Venta {
  id              String     @id @default(cuid())
  numero          Int        @unique @default(autoincrement()) // folio del comprobante
  turno           Turno      @relation(fields: [turnoId], references: [id])
  turnoId         String
  cliente         String?
  metodoPago      MetodoPago
  subtotal        Int
  descuento       Int        @default(0) // % 0-100
  total           Int
  notas           String?
  vendedor        User       @relation("VentaVendedor", fields: [vendedorId], references: [id])
  vendedorId      String
  items           VentaItem[]
  // Anulación lógica (nunca DELETE): repone stock y sale del reporte mensual,
  // pero queda visible en el historial para trazabilidad.
  anuladaAt       DateTime?
  anuladaPor      User?      @relation("VentaAnuladaPor", fields: [anuladaPorId], references: [id], onDelete: SetNull)
  anuladaPorId    String?
  motivoAnulacion String?
  documento       DocumentoTributario?
  createdAt       DateTime   @default(now())

  @@index([turnoId])
  @@index([vendedorId])
  @@index([createdAt])
  @@index([anuladaAt])
}

model VentaItem {
  id               String          @id @default(cuid())
  venta            Venta           @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  ventaId          String
  product          Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId        Int?
  inventarioItem   InventarioItem? @relation(fields: [inventarioItemId], references: [id], onDelete: SetNull)
  inventarioItemId String?
  // Venta de un tratamiento clinico: no mueve stock y su precio se fija al
  // vender, porque el catalogo maneja un rango (valorDesde/valorHasta).
  treatment        Treatment?      @relation("VentaItemTratamiento", fields: [treatmentId], references: [id], onDelete: SetNull)
  treatmentId      String?
  nombre           String // snapshot del nombre al momento de vender
  precioUnitario   Int    // snapshot del precio al momento de vender
  cantidad         Int
  movimientos      InventarioMovimiento[]

  @@index([ventaId])
  @@index([productId])
  @@index([inventarioItemId])
  @@index([treatmentId])
}

// Pago de honorarios a un profesional. Registro central: varios por profesional/mes.
model PagoProfesional {
  id             String       @id @default(cuid())
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  professionalId String
  periodo        String       // mes al que pertenece, formato "YYYY-MM"
  monto          Int          @default(0) // CLP
  estado         PagoEstado   @default(PENDIENTE_PAGO)
  fechaPago      DateTime?    // cuándo se pagó efectivamente
  notas          String?
  creadoPor      User?        @relation("PagoProfCreador", fields: [creadoPorId], references: [id], onDelete: SetNull)
  creadoPorId    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([professionalId])
  @@index([periodo])
  @@index([estado])
}

// ───────────────────────────── Chat interno ─────────────────────────────

model Conversation {
  id        String   @id @default(cuid())
  esGrupo   Boolean  @default(false)
  // Canal por rol: si `roles` no está vacío, es un canal cuyos miembros son
  // todos los usuarios activos con esos roles (ej. "Recepción").
  roles     Role[]   @default([])
  nombre    String?  // nombre del grupo/canal (null en DMs)
  // Para DMs: clave canónica "menorId:mayorId" → unicidad garantizada por la BD.
  dmKey     String?  @unique
  // Buzón de estación: conversación privada entre un Box y todo el equipo de
  // Recepción. `buzonBoxId` = la cuenta Box dueña; miembros = ese Box + todos
  // los usuarios activos con rol RECEPCION. El título es dinámico según quién mira:
  // el box ve "Recepción"; recepción ve el nombre del box.
  buzonBoxId String?  @unique
  buzonBox   User?    @relation("BuzonBox", fields: [buzonBoxId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt // se toca con cada mensaje, para ordenar

  members  ConversationMember[]
  messages Message[]

  @@index([updatedAt])
}

model ConversationMember {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  lastReadAt     DateTime?    // última vez que el usuario abrió la conversación
  joinedAt       DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  autor          User         @relation(fields: [autorId], references: [id], onDelete: Cascade)
  autorId        String
  contenido      String
  editedAt       DateTime?
  parent         Message?     @relation("MessageReplies", fields: [parentId], references: [id], onDelete: SetNull)
  parentId       String?
  replies        Message[]    @relation("MessageReplies")
  createdAt      DateTime     @default(now())

  reactions MessageReaction[]

  @@index([conversationId, createdAt])
  @@index([parentId])
}

model MessageReaction {
  id        String   @id @default(cuid())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

// ───────────────────────────── Data clínica ─────────────────────────────

model Treatment {
  id                String   @id // slug original (ej. 'toxina-tercio-superior')
  categoria         String
  subcategoria      String?
  nombre            String
  descripcion       String
  profesional       String?
  especialidad      String?
  valorDesde        Int?
  valorHasta        Int?
  duracion          String?
  sesiones          String?
  protocolo         String?
  requiereEvaluacion Boolean @default(false)
  indicaciones      String[]
  contraindicaciones String[]
  preTratamiento    String[]
  postTratamiento   String[]
  extra             Json?

  profesionales TreatmentProfessional[]
  ventaItems    VentaItem[] @relation("VentaItemTratamiento")

  @@index([categoria])
}

model Professional {
  id             String   @id // slug original (ej. 'nicolas-laucirica')
  nombreCompleto String
  especialidad   String
  rut            String?
  telefono       String?
  email          String?
  disponibilidad Json?
  prestaciones   Json?
  extra          Json?

  tratamientos TreatmentProfessional[]
  usuarios     User[]
  cirugias     Cirugia[]
  inventarioMovimientos InventarioMovimiento[] @relation("InventarioMovProfesional")
  pagos        PagoProfesional[]

  @@index([especialidad])
}

// Tabla relacional muchos-a-muchos tratamiento ↔ profesional.
model TreatmentProfessional {
  treatment      Treatment    @relation(fields: [treatmentId], references: [id], onDelete: Cascade)
  treatmentId    String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  professionalId String

  @@id([treatmentId, professionalId])
  @@index([professionalId])
}

model Product {
  id          Int    @id // id numérico original
  brand       String
  name        String
  price       Int
  category    String?
  description String?

  insumos CirugiaInsumo[]

  // Vínculo 1:1 opcional con el inventario: si está seteado, la Caja descuenta
  // stock real al vender este producto.
  inventarioItem   InventarioItem? @relation(fields: [inventarioItemId], references: [id], onDelete: SetNull)
  inventarioItemId String?         @unique
  ventaItems       VentaItem[]

  @@index([brand])
}

model Consultation {
  id            String  @id // slug original
  categoria     String?
  emoji         String?
  nombre        String
  descripcion   String
  valor         String
  duracion      String?
  reembolsable  Boolean @default(false)
  profesionales Json?
}

model Box {
  id              Int      @id // id numérico original
  nombre          String
  alias           String?
  tipo            String?
  descripcion     String?
  usosPrincipales String[]
  equipamiento    Json?
}

model Consent {
  id                String   @id // slug original
  title             String
  treatment         String
  introduction      String
  beneficios        String[]
  efectosSecundarios String[]
  contraindicaciones String[]
  cuidados          String[]
  extra             Json?

  firmas SignedConsent[]
  reglas ReglaConsentimiento[]
}

// ─────────────────── Consentimientos enviados a firma digital ───────────────────

/** Quién estampa la firma: el paciente o su representante legal. */
enum FirmanteRelacion {
  TITULAR   // el propio paciente
  MADRE
  PADRE
  TUTOR
  APODERADO
  OTRO
}

enum ConsentEstado {
  PENDIENTE // enviado, esperando firma del paciente
  FIRMADO   // el paciente firmó
  ANULADO   // recepción lo anuló
}

// Una instancia de un consentimiento enviado a un paciente para firma electrónica
// simple (Ley 19.799 + 20.584). El enlace público usa `token` como secreto.
model SignedConsent {
  id          String        @id @default(cuid())
  token       String        @unique // secreto del enlace público (/firma/:token)

  // Plantilla de origen + snapshot inmutable de su contenido al momento de enviar.
  consent     Consent?      @relation(fields: [consentId], references: [id], onDelete: SetNull)
  consentId   String?
  titulo      String
  tratamiento String
  snapshot    Json          // { introduction, beneficios[], efectosSecundarios[], contraindicaciones[], cuidados[] }

  // Datos del paciente (los completa recepción al enviar).
  paciente      String
  rut           String
  profesional   String
  procedimiento String
  telefono      String?
  email         String?
  fecha         String   // fecha mostrada en el documento (DD/MM/AAAA)

  estado      ConsentEstado @default(PENDIENTE)

  // Resultado de la firma (se llena cuando el paciente firma).
  firmaImagen    String?   @db.Text // dataURL PNG de la firma dibujada
  firmanteNombre String?            // nombre que confirmó el paciente
  fotoAuth       Boolean?           // true = autoriza registro fotográfico, false = no, null = sin firmar
  firmadoAt      DateTime?
  firmaIp        String?            // evidencia de auditoría
  firmaUserAgent String?

  // Representante legal: para menores de edad o personas con incapacidad, la
  // Ley 20.584 exige el consentimiento de quien los representa. `TITULAR`
  // significa que firmó el propio paciente.
  firmanteRelacion FirmanteRelacion @default(TITULAR)
  firmanteRut      String?          // RUT de quien firma (paciente o representante)

  // Firma en papel: quién la declara y el respaldo escaneado. Sin esto, un
  // consentimiento marcado como firmado no puede exhibirse ante fiscalización.
  firmaManualPor   User?    @relation("ConsentFirmaManualPor", fields: [firmaManualPorId], references: [id], onDelete: SetNull)
  firmaManualPorId String?
  firmaManualObs   String?  // dónde está el papel / observaciones
  respaldoPath     String?  // ruta relativa dentro de uploads/ (escaneo del papel)
  respaldoMime     String?
  respaldoSize     Int?

  // Anulación trazable: un registro legal no puede cambiar de estado sin huella.
  anuladoPor      User?     @relation("ConsentAnuladoPor", fields: [anuladoPorId], references: [id], onDelete: SetNull)
  anuladoPorId    String?
  anuladoAt       DateTime?
  motivoAnulacion String?

  creadoPor   User?         @relation("ConsentCreador", fields: [creadoPorId], references: [id], onDelete: SetNull)
  creadoPorId String?

  emailEnviadoAt DateTime?          // última vez que se envió el correo al paciente
  firmaManual    Boolean  @default(false) // firmado en papel (presencial), marcado por recepción
  expiresAt      DateTime?          // vencimiento del enlace (null = sin límite para registros legacy)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([estado])
  @@index([createdAt])
}

// ─────────────── Documentos tributarios electronicos (SII) ───────────────

/** Tipos de DTE que emite la clinica. El numero es el codigo oficial del SII. */
enum TipoDte {
  BOLETA_AFECTA // 39 - lleva IVA; puede incluir lineas exentas adentro
  BOLETA_EXENTA // 41 - venta completamente exenta (solo tratamientos)
}

enum EstadoDte {
  PENDIENTE // folio asignado y documento emitido; falta enviarlo al SII
  ENVIADA   // enviada al SII, esperando resolucion
  ACEPTADA
  RECHAZADA
  ANULADA
}

/**
 * CAF (Codigo de Autorizacion de Folios): archivo que entrega el SII con un
 * rango de folios y la llave privada para timbrarlos. `siguiente` avanza de a
 * uno y nunca retrocede; repetir un folio es un problema tributario, asi que la
 * asignacion se hace con un UPDATE atomico (ver folios.ts).
 */
model Caf {
  id          String    @id @default(cuid())
  tipo        TipoDte
  desde       Int
  hasta       Int
  siguiente   Int       // proximo folio disponible dentro del rango
  xml         String    // CAF tal como lo entrega el SII
  activo      Boolean   @default(true)
  vencimiento DateTime?
  notas       String?
  cargadoPor   User?    @relation("CafCargadoPor", fields: [cargadoPorId], references: [id], onDelete: SetNull)
  cargadoPorId String?
  documentos  DocumentoTributario[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tipo, activo])
}

/** Boleta electronica asociada a una venta de caja. Una venta, un documento. */
model DocumentoTributario {
  id      String    @id @default(cuid())
  venta   Venta     @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  ventaId String    @unique
  tipo    TipoDte
  folio   Int
  caf     Caf?      @relation(fields: [cafId], references: [id], onDelete: SetNull)
  cafId   String?

  fechaEmision DateTime @default(now())

  // Montos en pesos. Invariante: neto + iva + exento == total == Venta.total
  neto   Int @default(0)
  exento Int @default(0)
  iva    Int @default(0)
  total  Int

  estado       EstadoDte @default(PENDIENTE)
  xml          String?   // DTE firmado
  ted          String?   // timbre electronico
  trackId      String?   // id de seguimiento que devuelve el SII
  respuestaSii String?
  enviadoAt    DateTime?
  resueltoAt   DateTime?
  intentos     Int       @default(0)
  ultimoError  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tipo, folio])
  @@index([estado])
  @@index([fechaEmision])
}

model FaqItem {
  id        String   @id // slug original
  categoria String
  pregunta  String
  respuesta String
  tags      String[]

  @@index([categoria])
}

// Protocolos base de recepción (protocolRules).
model Protocol {
  id      String @id // número como string ('1'..'17')
  numero  Int
  titulo  String
  contenido String

  @@index([numero])
}

// Guiones técnicos (scriptsData), aplanados por categoría.
model Script {
  id        String  @id @default(cuid())
  categoria String
  titulo    String
  contenido String  @db.Text
  nota      String?
  orden     Int     @default(0)

  @@index([categoria])
}

// Políticas de pago y de paquetes (paymentPolicies).
model PaymentPolicy {
  id       String @id @default(cuid())
  titulo   String
  contenido String @db.Text
  tipo     String
  orden    Int    @default(0)

  @@index([tipo])
}

// Protocolos internos por área (protocolsData).
model InternalProtocol {
  id       String @id // clave original (ej. 'recepcion')
  titulo   String
  icon     String?
  color    String?
  sections Json
  orden    Int    @default(0)
}

// ─────────────────────────────── Cirugías / Procedimientos ─────────────────────────────────

model Cirugia {
  id             String        @id @default(cuid())
  paciente       String
  tipo           String        // texto libre: "Rinoplastia", "Blefaroplastia", etc.
  telefono       String?
  email          String?
  etapa            EtapaCirugia  @default(EVALUACION)
  etapaCambiadaAt  DateTime?
  notas            String?
  fechaCirugia     DateTime?

  professional   Professional? @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  professionalId String?

  creadoPor      User?         @relation("CirugiaCreador", fields: [creadoPorId], references: [id], onDelete: SetNull)
  creadoPorId    String?

  presupuesto    Presupuesto?
  abonos         CirugiaAbono[]
  insumos        CirugiaInsumo[]
  comunicaciones ComunicacionLog[]
  actividad      CirugiaActividad[]
  tareas         Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([etapa])
  @@index([professionalId])
}

model Presupuesto {
  id          String            @id @default(cuid())
  cirugia     Cirugia           @relation(fields: [cirugiaId], references: [id], onDelete: Cascade)
  cirugiaId   String            @unique
  monto       Int               @default(0)
  descuento   Int               @default(0)
  estado      PresupuestoEstado @default(PENDIENTE)
  enviadoAt   DateTime?
  notas       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model CirugiaAbono {
  id              String     @id @default(cuid())
  cirugia         Cirugia    @relation(fields: [cirugiaId], references: [id], onDelete: Cascade)
  cirugiaId       String
  monto           Int
  metodo          MetodoPago @default(EFECTIVO)
  fecha           DateTime   @default(now())
  notas           String?
  registradoPor   User?      @relation("AbonoRegistradoPor", fields: [registradoPorId], references: [id], onDelete: SetNull)
  registradoPorId String?
  createdAt       DateTime   @default(now())

  @@index([cirugiaId])
}

model CirugiaInsumo {
  id        String     @id @default(cuid())
  cirugia   Cirugia    @relation(fields: [cirugiaId], references: [id], onDelete: Cascade)
  cirugiaId String
  tipo      InsumoTipo @default(INSUMO)
  nombre    String
  product   Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId Int?
  cantidad  Int        @default(1)
  unidad    String?
  listo     Boolean    @default(false)
  createdAt DateTime   @default(now())

  @@index([cirugiaId])
}

model ComunicacionLog {
  id          String            @id @default(cuid())
  cirugia     Cirugia           @relation(fields: [cirugiaId], references: [id], onDelete: Cascade)
  cirugiaId   String
  canal       CanalComunicacion @default(LLAMADA)
  descripcion String
  usuario     User              @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId   String
  createdAt   DateTime          @default(now())

  @@index([cirugiaId])
}

model CirugiaActividad {
  id          String   @id @default(cuid())
  cirugia     Cirugia  @relation(fields: [cirugiaId], references: [id], onDelete: Cascade)
  cirugiaId   String
  tipo        String   // "ETAPA" | "PRESUPUESTO" | "INSUMO" | "TAREA"
  descripcion String
  datos       Json?
  usuario     User     @relation("CirugiaActividadUsuario", fields: [usuarioId], references: [id])
  usuarioId   String
  createdAt   DateTime @default(now())

  @@index([cirugiaId])
}

// ─────────────────────────────── Inventario ─────────────────────────────────

model StorageLocation {
  id           String   @id @default(cuid())
  nombre       String
  codigo       String   @unique
  descripcion  String?
  tipo         String   @default("storage")
  activo       Boolean  @default(true)
  parentId     String?
  parent       StorageLocation?  @relation("UbicacionHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     StorageLocation[] @relation("UbicacionHierarchy")

  locationInventario     LocationInventario[]
  movimientosOrigen      InventarioMovimiento[] @relation("MovimientoUbicacion")
  movimientosDestino     InventarioMovimiento[] @relation("MovimientoDestino")

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([activo])
  @@index([parentId])
}

model LocationInventario {
  id           String          @id @default(cuid())
  locationId   String
  location     StorageLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  itemId       String
  item         InventarioItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantity     Int             @default(0)
  stockMinimo  Int?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([locationId, itemId])
  @@index([itemId])
  @@index([quantity])
}

model InventarioItem {
  id           String   @id @default(cuid())
  nombre       String
  sku          String?  @unique
  codigoBarras String?
  descripcion  String?
  stock        Int      @default(0)
  stockMinimo  Int      @default(0)
  unidad       String   @default("unidad")
  categoria    String?
  costo        Decimal  @default(0) @db.Decimal(10, 2)
  activo       Boolean  @default(true)
  notas        String?

  movimientos        InventarioMovimiento[]
  locationInventario LocationInventario[]
  producto           Product?
  ventaItems         VentaItem[]

  creadoPor    User?    @relation("InventarioCreadoPor", fields: [creadoPorId], references: [id], onDelete: SetNull)
  creadoPorId  String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([categoria])
  @@index([activo])
  @@index([stock])
}

model InventarioMovimiento {
  id             String   @id @default(cuid())
  item           InventarioItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId         String
  tipo           String   // 'ENTRADA' | 'SALIDA' | 'AJUSTE' | 'TRASLADO'
  cantidad       Int
  stockAntes     Int
  stockDespues   Int
  codigoMotivo   String?  // 'compra' | 'consumo' | 'vencimiento' | 'perdida' | 'devolucion' | 'ajuste' | 'traslado'
  notas          String?

  ubicacion              StorageLocation? @relation("MovimientoUbicacion", fields: [ubicacionId], references: [id], onDelete: SetNull)
  ubicacionId            String?
  ubicacionDestino       StorageLocation? @relation("MovimientoDestino", fields: [ubicacionDestinoId], references: [id], onDelete: SetNull)
  ubicacionDestinoId     String?

  profesional    Professional? @relation("InventarioMovProfesional", fields: [profesionalId], references: [id], onDelete: SetNull)
  profesionalId  String?
  realizadoPor   User?    @relation("InventarioMovUsuario", fields: [realizadoPorId], references: [id], onDelete: SetNull)
  realizadoPorId String?
  // Trazabilidad de ventas de caja: SIN @unique — un mismo VentaItem genera la
  // SALIDA al vender y una ENTRADA de devolución si la venta se anula.
  ventaItem      VentaItem? @relation(fields: [ventaItemId], references: [id], onDelete: SetNull)
  ventaItemId    String?
  fechaMovimiento DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([itemId, fechaMovimiento])
  @@index([fechaMovimiento])
  @@index([tipo])
  @@index([ventaItemId])
  @@index([ubicacionId])
}

// ─────────────────── Citas sincronizadas desde Reservo ───────────────────

/**
 * Espejo local de la agenda de reservo.cl. Se rellena con `GET /agenda` de la
 * API reservo-api (mismo VPS, 127.0.0.1:4000) y se refresca en cada sync.
 *
 * Reservo no expone un id de cita, así que la identidad se deriva de los datos
 * que no cambian dentro de un mismo bloque (`claveReservo`). Si recepción mueve
 * la hora o cambia el servicio en Reservo, la cita entra como una nueva y la
 * anterior queda marcada `vigente = false` en el sync de ese día.
 */
model Cita {
  id           String   @id @default(cuid())
  claveReservo String   @unique // sha1(fecha|hora|idPaciente|profesional|servicio)

  fecha       DateTime // día de la cita (a medianoche, hora local)
  hora        String   // "09:00 - 10:00" tal como lo entrega Reservo
  paciente    String
  rut         String?
  rutNorm     String?  // RUT sin puntos ni guion, para cruzar con consentimientos
  ficha       String?
  idPaciente  String?  // id de Reservo, para /finanzas/paciente/:id
  servicio    String
  comentario  String?
  profesional String
  box         String?
  contacto    String?

  estado     String // Atendido | Confirmado | No llegó | Suspendió | ...
  estadoPago String // Pagado | No pagado | Plan
  atendido   Boolean @default(false)
  pagado     Boolean @default(false)

  // false = ya no aparece en la agenda de Reservo para ese día (movida o borrada).
  vigente    Boolean  @default(true)
  sincronizadoAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fecha, vigente])
  @@index([rutNorm])
  @@index([profesional])
}

/**
 * Protocolo: qué consentimiento corresponde a qué servicio de la agenda.
 *
 * `patron` se compara contra el nombre del servicio de Reservo normalizado
 * (minúsculas, sin tildes), por coincidencia parcial: el patrón "embody" calza
 * con "1 sesión Embody" y con "Embody x3".
 */
model ReglaConsentimiento {
  id        String  @id @default(cuid())
  patron    String  // texto a buscar dentro del servicio de la cita
  consent   Consent @relation(fields: [consentId], references: [id], onDelete: Cascade)
  consentId String

  activo Boolean @default(true)
  // Días de anticipación con que se prepara el consentimiento antes de la cita.
  diasAnticipacion Int @default(3)
  // false = sólo se avisa a recepción; true = se crea y envía el correo solo.
  autoEnviar Boolean @default(false)

  creadoPor   User?   @relation("ReglaConsentimientoCreador", fields: [creadoPorId], references: [id], onDelete: SetNull)
  creadoPorId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([patron, consentId])
  @@index([activo])
}

{
  "manifest_version": 3,
  "name": "Cialo Hub · Ventas de Reservo",
  "version": "2.0.0",
  "description": "Al realizar una venta en Reservo, abre la caja de Cialo Hub con la venta cargada.",
  "permissions": ["storage", "webRequest"],
  "host_permissions": ["https://reservo.cl/*", "https://administracion.cialo.cl/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://reservo.cl/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://administracion.cialo.cl/*"],
      "js": ["puente.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cialo Hub · Ventas de Reservo",
    "default_icon": { "128": "icono.png" }
  },
  "icons": { "128": "icono.png" }
}
